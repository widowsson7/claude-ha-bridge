# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram user ID (get it from @userinfobot). Comma-separate for multiple.
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Claude ---
# Directory the agent works in. Point this at your Home Assistant config
# (or a git checkout of it) so file edits and .mcp.json are picked up there.
CLAUDE_WORKDIR=/home/user/homeassistant

# acceptEdits = auto-approve file edits, ask for the rest (via config rules).
# bypassPermissions = never ask (needed for fully hands-off phone use, but
# understand what that means before enabling).
CLAUDE_PERMISSION_MODE=acceptEdits

# Directories the agent may access beyond CLAUDE_WORKDIR (comma-separated).
# This is the sandbox boundary: a permissions.allow rule does NOT extend it.
CLAUDE_ADD_DIRS=/opt/claude-bridge

# Optional: pin a model; leave unset for the default.
#CLAUDE_MODEL=

# Set to 1 to get a "🔧 tool" line in Telegram for each tool the agent uses.
BRIDGE_SHOW_TOOLS=0

# --- Resource controls ---
# Seconds of inactivity before a tab's Claude client is disconnected. The
# session id is kept, so the next message resumes the same conversation.
BRIDGE_IDLE_TIMEOUT=600
# Maximum tabs running a Claude turn at once; the rest queue.
BRIDGE_MAX_CONCURRENT=2
# Where downloaded Telegram media (photos/documents/voice) is written.
MEDIA_DIR=/opt/claude-bridge/media

# Where session ids are persisted. Defaults to state.json next to bridge.py.
#BRIDGE_STATE_FILE=/opt/claude-bridge/state.json

# Standard Python log levels: DEBUG, INFO, WARNING, ERROR.
#LOG_LEVEL=INFO

# --- Claude authentication (pick one) ---
# NOTE: all three are commented out below. Uncomment the ONE you are using.
# Pasting a value next to a still-commented line does nothing.
# 1. Subscription auth. Run `claude setup-token` on this machine and paste the
#    result here. This is the usual choice if you have a Claude subscription.
#CLAUDE_CODE_OAUTH_TOKEN=
#
# 2. API billing. An Anthropic API key instead.
#ANTHROPIC_API_KEY=
#
# 3. Neither: run `claude` once interactively and log in. The SDK then picks up
#    the stored credential, but note the service must have HOME set for that
#    to be found (the bundled unit sets HOME=/root).
